<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============== Colores para el Tema Oscuro ============== -->

    <!-- Colores Invertidos Principales -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- El fondo ahora es un marrón muy oscuro -->
    <color name="background_color">#FF1E1A18</color>

    <!-- El color primario se hace un poco más claro para que resalte en el fondo oscuro -->
    <color name="primary_color">#8A8A8A</color>

    <!-- El texto principal ahora es un color hueso claro -->
    <color name="text_color">#E8E8E8</color>

    <!-- El texto de hint es un gris cálido más oscuro -->
    <color name="hint_color">#A6A59D</color>

    <!-- El rojo para eventos se hace más brillante para ser visible -->
    <color name="event_day_color">#30FF00</color>

    <!-- Colores de Texto sobre Fondos Claros (en modo oscuro, estos se invierten) -->
    <color name="text_on_dark_primary">#FFFFFFFF</color>
    <color name="text_on_dark_secondary">#F5F5F5</color>
    <color name="text_on_dark_hint">#EBE9E1</color>

    <!-- Colores de Superficie Oscuros -->
    <color name="surface_parchment">#FF2A2421</color> <!-- Superficie de "pergamino" oscuro -->
    <color name="surface_highlight_almond">#FF362F2B</color> <!-- Destaque sutil oscuro -->
    <color name="border_subtle_beige">#FF443A36</color> <!-- Borde visible pero tenue -->

    <!-- El fondo de "cosas" (como tarjetas) es un marrón ligeramente más claro que el fondo principal -->
    <color name="background_color_things">#FF2A2421</color>

    <!-- El acento durazno se hace más brillante para resaltar -->
    <color name="peach_accent">#DED6C5</color>

    <!-- Colores de Advertencia adaptados para fondo oscuro -->
    <color name="warning_background_color">#33FFD180</color> <!-- Amarillo/Naranja transparente -->
    <color name="warning_text_color">#FFFFE082</color>      <!-- Amarillo pálido para el texto -->

</resources>
