<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ESTADO: Cuando el item está SELECCIONADO -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <!-- CAMBIA ESTE COLOR POR EL QUE QUIERAS DE TUS COLORES PREDEFINIDOS -->
            <solid android:color="@color/background_color_things" />
            <!-- Esto hace que los bordes sean redondeados, ajústalo si quieres -->
            <corners android:radius="50dp" />
        </shape>
    </item>

    <!-- ESTADO: Por defecto (cuando el item NO está seleccionado) -->
    <item android:drawable="@android:color/transparent" />

</selector>
