<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base de la aplicación -->
    <style name="Base.Theme.ProyectoAula" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Color de la barra de estado -->
        <item name="android:statusBarColor">@color/primary_color</item>

        <!-- CONFIGURACIÓN PARA ELIMINAR EL MORADO (Sobreescribimos la paleta de Material 3) -->
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Estos tres quitan el morado de los fondos de botones y switches -->
        <item name="colorSecondary">@color/hint_color</item>
        <item name="colorTertiary">@color/peach_accent</item>
        <item name="colorContainer">@color/background_color_things</item>

        <!-- Color de acento para componentes activos -->
        <item name="colorAccent">@color/primary_color</item>
        <item name="android:colorAccent">@color/primary_color</item>
        <item name="android:colorControlActivated">@color/primary_color</item>

        <!-- COLOR DE FONDO (CAFÉ DURAZNO) -->
        <item name="android:windowBackground">@color/background_color</item>

        <!-- TEMA PERSONALIZADO PARA EL RELOJ (Sin el error anterior) -->
        <item name="materialTimePickerTheme">@style/CustomTimePickerTheme</item>
    </style>

    <style name="Theme.ProyectoAula" parent="Base.Theme.ProyectoAula" />

    <!-- ESTILO PARA EL RELOJ (Corregido para evitar el error de carga) -->
    <style name="CustomTimePickerTheme" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/background_color</item>
        <item name="colorOnSurface">@color/text_color</item>
        <!-- Colores para los números y el círculo selector -->
        <item name="colorSecondaryContainer">@color/peach_accent</item>
        <item name="colorOnSecondaryContainer">@color/text_color</item>
    </style>

    <!-- SPLASH SCREEN -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_color</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/icono</item>
        <item name="postSplashScreenTheme">@style/Theme.ProyectoAula</item>
    </style>

    <!-- Estilo General de Botones -->
    <style name="BotonMarron" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/primary_color</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- Estilos para el Calendario -->
    <style name="CalendarDateText" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">@color/special_text_day_calerndar</item>
        <item name="android:textFontWeight">250</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalendarHeaderText" parent="TextAppearance.AppCompat.Large">
        <item name="android:textColor">@color/primary_color</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomWeekDayText" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@color/primary_color</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textFontWeight">650</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ======================= INICIO DE LA CORRECCIÓN ======================= -->
    <!-- Este estilo ahora solo es para los iconos (menú hamburguesa) -->
    <style name="ToolbarTheme" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorSecondary">@color/white</item>
    </style>
</resources>
